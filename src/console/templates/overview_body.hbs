<section class="stats">
  <div class="stat">
    <div class="stat-label">Conectadas</div>
    <div class="stat-num">{{connected}}<span class="of"> / {{total}}</span></div>
    <div class="stat-foot">sessões prontas para enviar e receber</div>
  </div>
  <div class="stat {{#if pairing_count}}warn{{/if}}">
    <div class="stat-label">Aguardando vínculo</div>
    <div class="stat-num">{{pairing_count}}</div>
    <div class="stat-foot">exibindo QR Code ou conectando</div>
  </div>
  <div class="stat">
    <div class="stat-label">Desconectadas</div>
    <div class="stat-num">{{disconnected_count}}</div>
    <div class="stat-foot">dados preservados para reconectar</div>
  </div>
  <div class="stat {{#if circuits_open}}alert{{/if}}">
    <div class="stat-label">Webhooks</div>
    <div class="stat-num">{{webhook_count}}</div>
    <div class="stat-foot">{{#if circuits_open}}{{circuits_open}} suspensos após falhas nas entregas{{else}}entregas ativas{{/if}}</div>
  </div>
</section>

<section class="overview-grid">
  <article class="panel">
    <header class="panel-head">
      <span class="panel-title">Sessões</span>
      {{#if has_sessions}}<span class="panel-note">{{sessions_count}}</span>{{/if}}
      <span class="spacer"></span>
      <button class="btn primary" onclick="openNewSession()">
        <svg class="icon sm"><use href="#i-plus"/></svg>
        Nova sessão
      </button>
    </header>
    {{#if has_sessions}}
    <table class="table">
      <thead>
        <tr>
          <th>Sessão</th>
          <th>Canal</th>
          <th class="hide-sm">Número</th>
          <th>Status</th>
          <th class="hide-sm">Webhooks</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      {{#each sessions}}
        <tr class="clickable" onclick="location.href='/s/'+encodeURIComponent('{{id}}')">
          <td>
            <div class="cell-id">{{id}}</div>
            {{#if name}}<div class="cell-sub">{{name}}</div>{{/if}}
          </td>
          <td>
            {{#if is_cloud}}
            <span class="channel cloud"><svg class="icon sm"><use href="#i-cloud"/></svg>Cloud API</span>
            {{else}}
            <span class="channel web"><svg class="icon sm"><use href="#i-link"/></svg>WhatsApp Web</span>
            {{/if}}
          </td>
          <td class="cell-num hide-sm">{{#if phone}}{{phone}}{{else}}<span class="muted">—</span>{{/if}}</td>
          <td><span class="status {{status_class}}">{{status_label}}</span></td>
          <td class="hide-sm">
            {{#if webhooks_suspended}}
            <span class="chip bad">{{webhooks_suspended}} de {{webhooks}} suspensos</span>
            {{else}}{{#if webhooks}}
            <span class="chip ok">{{webhooks}} entregando</span>
            {{else}}
            <span class="chip">nenhum</span>
            {{/if}}{{/if}}
          </td>
          <td>
            <span class="btn-row" style="justify-content:flex-end">
              {{#if can_connect}}
              <button class="btn sm" onclick="event.stopPropagation();sessionAction('{{id}}','connect')">Conectar</button>
              {{/if}}
              {{#if can_disconnect}}
              <button class="btn sm" onclick="event.stopPropagation();sessionAction('{{id}}','disconnect')">Desconectar</button>
              {{/if}}
              <a class="btn sm" href="/s/{{id}}" onclick="event.stopPropagation()">Abrir</a>
            </span>
          </td>
        </tr>
      {{/each}}
      </tbody>
    </table>
    {{else}}
    <div class="empty">
      Nenhuma sessão cadastrada. Cada sessão representa um número de WhatsApp:
      um aparelho vinculado pelo WhatsApp Web ou um número da Cloud API da Meta.
      <div style="margin-top:16px">
        <button class="btn primary" onclick="openNewSession()">
          <svg class="icon sm"><use href="#i-plus"/></svg>
          Nova sessão
        </button>
      </div>
    </div>
    {{/if}}
  </article>

  <article class="panel">
    <header class="panel-head">
      <span class="panel-title">Atividade</span>
      <span class="panel-note">{{event_rate}} no último minuto</span>
    </header>
    <div class="activity">
      {{#if has_events}}
        {{#each events}}
        <div class="activity-row">
          <span class="activity-time">{{time}}</span>
          <div class="activity-main">
            <div><span class="activity-kind {{level}}">{{kind}}</span> <span class="activity-sid">{{session}}</span></div>
            {{#if msg}}<div class="activity-msg">{{msg}}</div>{{/if}}
          </div>
        </div>
        {{/each}}
      {{else}}
      <div class="empty">Sem atividade por enquanto. Os eventos aparecem quando as sessões se conectam e recebem mensagens.</div>
      {{/if}}
    </div>
  </article>
</section>
