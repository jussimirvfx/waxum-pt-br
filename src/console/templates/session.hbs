<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/" aria-label="Página inicial do Waxum">
      <img src="/assets/logo.png" alt="" class="brand-mark" width="32" height="32">
      <span>Waxum</span>
      <span class="brand-chip">Painel</span>
    </a>
    <span class="spacer"></span>
    <span class="version">v{{version}}</span>
    <a class="topbar-link" href="/swagger-ui" target="_blank" rel="noopener">
      <svg class="icon sm"><use href="#i-book"/></svg>
      Documentação da API
    </a>
    <form method="post" action="/logout" style="margin:0">
      <button type="submit" class="btn sm ghost">
        <svg class="icon sm"><use href="#i-power"/></svg>
        Sair
      </button>
    </form>
  </div>
</header>

<main class="page">
  <div class="crumbs"><a href="/">Sessões</a> / {{session_id}}</div>

  <section class="session-head {{#if cloud}}cloud{{else}}web{{/if}}">
    <div>
      <h1 class="session-id">{{session_id}}</h1>
      <div class="session-meta">
        {{#if cloud}}
        <span class="channel cloud"><svg class="icon sm"><use href="#i-cloud"/></svg>Cloud API</span>
        {{else}}
        <span class="channel web"><svg class="icon sm"><use href="#i-link"/></svg>WhatsApp Web</span>
        {{/if}}
        <span id="head-status" class="status {{status_class}}">{{status_label}}</span>
        <span id="head-phone" class="cell-num">{{#if phone}}{{phone}}{{/if}}</span>
      </div>
      <div class="hint session-channel-note">
        {{#if cloud}}
        Número na Cloud API oficial da Meta, sem vínculo por QR Code.
        Oferece modelos de mensagem, Flows, catálogos e estatísticas.
        Grupos, chamadas, contatos e presença não estão disponíveis neste canal.
        {{else}}
        Aparelho vinculado pelo WhatsApp Web, com recursos como grupos e chamadas.
        Os recursos exclusivos da Cloud API, como modelos de mensagem, Flows
        e estatísticas, não estão disponíveis neste canal.
        {{/if}}
      </div>
    </div>
    <div class="btn-row" id="head-actions">
      {{#unless cloud}}
      <button class="btn primary" id="act-connect" onclick="consoleAction('connect')" hidden>Conectar</button>
      <button class="btn" id="act-disconnect" onclick="consoleAction('disconnect')" hidden>Desconectar</button>
      <button class="btn" id="act-logout" onclick="confirmLogout()" hidden>Desvincular</button>
      {{/unless}}
      <button class="btn danger" onclick="confirmDelete()">
        <svg class="icon sm"><use href="#i-trash"/></svg>
        Excluir
      </button>
    </div>
  </section>

  <section class="cards">
    {{#if cloud}}
    <article class="panel cloud-panel wide">
      <header class="panel-head">
        <span class="panel-title">Conexão com a Cloud API</span>
        <span class="panel-note">Meta WhatsApp Cloud API</span>
      </header>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:20px">
        <div class="kv">
          <div class="field"><label>ID da WABA</label><span class="val">{{#if cloud.waba_id}}{{cloud.waba_id}}{{else}}—{{/if}}</span></div>
          <div class="field"><label>ID do número de telefone</label><span class="val">{{#if cloud.phone_number_id}}{{cloud.phone_number_id}}{{else}}—{{/if}}</span></div>
          <div class="field"><label>ID da empresa</label><span class="val">{{#if cloud.business_id}}{{cloud.business_id}}{{else}}<span class="muted">não informado</span>{{/if}}</span></div>
          <div class="field"><label>ID do aplicativo</label><span class="val">{{#if cloud.app_id}}{{cloud.app_id}}{{else}}<span class="muted">não informado</span>{{/if}}</span></div>
        </div>
        <div class="field">
          <label>URL de retorno do webhook</label>
          <div class="copy-row"><code id="cloud-webhook-url"></code><button type="button" class="btn sm" data-copy="cloud-webhook-url">Copiar</button></div>
          <div class="hint">Cole no aplicativo da Meta em WhatsApp → Configuração → URL de retorno, com o token de verificação desta sessão. Depois, assine o campo <b>messages</b>.</div>
        </div>
        <div class="field">
          <label>URL do endpoint do Flow</label>
          <div class="copy-row"><code id="cloud-flow-url"></code><button type="button" class="btn sm" data-copy="cloud-flow-url">Copiar</button></div>
          <div class="hint">Use como <b>endpoint_uri</b> do Flow após configurar o endpoint em <b>Cloud · Flows</b> no explorador da API.</div>
        </div>
      </div>
    </article>
    {{else}}
    <article class="panel wide" id="connection-panel">
      <header class="panel-head">
        <span class="panel-title">Conexão</span>
        <span class="panel-note" id="connection-note"></span>
      </header>

      <div id="linked-view" class="panel-body" hidden>
        <div class="kv">
          <div class="field"><label>Número</label><span class="val" id="lv-phone">—</span></div>
          <div class="field"><label>Nome</label><span class="val" id="lv-name">—</span></div>
          <div class="field"><label>Últimos dados recebidos do WhatsApp</label><span class="val" id="lv-last">—</span></div>
          <div class="field"><label>Mensagens encaminhadas</label><span class="val" id="lv-forwarded">—</span></div>
        </div>
      </div>

      <div id="pair-panel" class="pair-panel pair-body" hidden>
        <div id="pair-qr" class="pair-qr"><div class="hint">Aguardando QR Code do WhatsApp…</div></div>
        <div class="pair-side">
          <div>
            <div class="panel-title">Vincular esta sessão a um telefone</div>
            <ol class="steps">
              <li>Abra o WhatsApp no telefone.</li>
              <li>Acesse <b>Aparelhos conectados</b> e toque em <b>Conectar um aparelho</b>.</li>
              <li>Aponte a câmera para este código. Ele é atualizado automaticamente.</li>
            </ol>
          </div>
          <div class="hint" id="pair-dormant-note" hidden>
            Esta sessão está desvinculada. Os webhooks, as configurações e as mensagens
            armazenadas foram preservados para continuar após um novo vínculo.
          </div>
          <details>
            <summary class="hint" style="cursor:pointer">Sem câmera? Vincule pelo número de telefone</summary>
            <div class="inline-form" style="margin-top:12px">
              <div class="field">
                <label for="pair-phone">Telefone no formato internacional</label>
                <input id="pair-phone" type="text" placeholder="5511999999999" autocomplete="off">
              </div>
              <button id="pair-request" type="button" class="btn">Obter código</button>
            </div>
            <div id="pair-code" class="pair-code" style="margin-top:12px" hidden></div>
            <div id="pair-code-hint" class="hint" hidden></div>
            <div id="pair-error" class="err" style="margin-top:8px" hidden></div>
          </details>
        </div>
      </div>
    </article>
    {{/if}}

    <article class="panel{{#if cloud}} wide{{/if}}">
      <header class="panel-head">
        <span class="panel-title">Webhooks</span>
        <span class="panel-note">destinos dos eventos desta sessão</span>
      </header>
      <div id="webhook-list" class="rows"><div class="empty">Carregando…</div></div>
      <form class="panel-foot" id="webhook-form">
        <div class="inline-form">
          <div class="field" style="flex:3 1 240px">
            <label for="wh-url">Adicionar URL de webhook</label>
            <input id="wh-url" type="url" placeholder="https://example.com/hooks/whatsapp" required>
          </div>
          <div class="field">
            <label for="wh-events">Eventos</label>
            <select id="wh-events">
              <option value="all">Todos os eventos</option>
              <option value="message">Apenas mensagens</option>
            </select>
          </div>
          <button type="submit" class="btn">Adicionar</button>
        </div>
        <div id="webhook-error" class="err" style="margin-top:8px" hidden></div>
      </form>
    </article>

    {{#unless cloud}}
    <article class="panel">
      <header class="panel-head">
        <span class="panel-title">Novas conversas</span>
        <span class="panel-note">conversas iniciadas com números novos nesta sessão</span>
      </header>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:16px">
        <div class="counters">
          <div class="counter"><div class="counter-num" id="nc-3">—</div><div class="counter-label">últimas 3 h</div></div>
          <div class="counter"><div class="counter-num" id="nc-6">—</div><div class="counter-label">últimas 6 h</div></div>
          <div class="counter"><div class="counter-num" id="nc-12">—</div><div class="counter-label">últimas 12 h</div></div>
          <div class="counter"><div class="counter-num" id="nc-24">—</div><div class="counter-label">últimas 24 h</div></div>
        </div>
        <div class="hint">
          O WhatsApp pode restringir contas que iniciam muitas conversas. Defina um
          limite para bloquear novos destinatários após atingi-lo, mantendo
          as conversas existentes. Apenas conversas iniciadas pelo Waxum são contadas.
        </div>
        <form class="inline-form" id="nc-form">
          <div class="field">
            <label for="nc-max">Máximo de novas conversas</label>
            <input id="nc-max" type="number" min="1" placeholder="sem limite">
          </div>
          <div class="field">
            <label for="nc-window">a cada (horas)</label>
            <input id="nc-window" type="number" min="1" max="720" value="24">
          </div>
          <button type="submit" class="btn">Salvar</button>
          <button type="button" class="btn ghost" id="nc-clear" hidden>Remover limite</button>
        </form>
        <div id="nc-state" class="hint"></div>
        <div id="nc-incidents"></div>
      </div>
    </article>
    {{/unless}}
  </section>

  <section class="explorer">
    <aside class="ex-nav">
      <div class="ex-nav-head">
        <input id="pg-filter" type="text" placeholder="Buscar operações da API" autocomplete="off" spellcheck="false">
      </div>
      <nav id="pg-sidebar-tree" class="ex-list"></nav>
    </aside>

    <div class="ex-main">
      <div class="ex-bar">
        <span class="ex-method" id="pg-method"></span>
        <code class="ex-url" id="pg-url">Selecione uma operação</code>
        <button type="button" class="btn sm" id="pg-curl" hidden>Copiar curl</button>
        <button type="button" class="btn sm primary" id="pg-send" hidden>Enviar</button>
      </div>
      <div class="ex-panes">
        <div class="ex-pane">
          <div class="ex-pane-title" id="pg-current-label">Requisição</div>
          <div id="pg-form" class="ex-form">
            <p class="muted">Escolha uma operação à esquerda para ver os parâmetros.</p>
          </div>
        </div>
        <div class="ex-pane">
          <div class="ex-pane-title">Resposta <span id="pg-result-status" class="ex-status"></span></div>
          <pre id="pg-result-body" class="ex-response"></pre>
        </div>
      </div>
    </div>
  </section>
</main>

<script>window.__SID__ = {{{sid_json}}}; window.__PROVIDER__ = {{{provider_json}}};</script>
<script src="/assets/playground.js"></script>
<script>
(function () {
  const sid = window.__SID__;
  const provider = window.__PROVIDER__ || 'web';
  const enc = encodeURIComponent(sid);
  const api = '/api/v1/sessions/' + enc;
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const setText = (id, v) => { const el = $(id); if (el) el.textContent = v; };
  const show = (id, on) => { const el = $(id); if (el) el.hidden = !on; };

  async function call(method, path, body) {
    const opts = { method, credentials: 'same-origin', headers: {} };
    if (body !== undefined) {
      opts.headers['content-type'] = 'application/json';
      opts.body = JSON.stringify(body);
    }
    const res = await fetch(path, opts);
    let json = null;
    try { json = await res.json(); } catch (_) {}
    return { ok: res.ok, status: res.status, json };
  }
  const errorOf = (r) => (r.json && ((r.json.error && r.json.error.message) || r.json.message)) || ('Falha na requisição (' + r.status + ')');

  function ago(unixSeconds) {
    if (!unixSeconds) return '—';
    const s = Math.max(0, Math.floor(Date.now() / 1000 - unixSeconds));
    if (s < 60) return 'há ' + s + ' s';
    if (s < 3600) return 'há ' + Math.floor(s / 60) + ' min';
    if (s < 86400) return 'há ' + Math.floor(s / 3600) + ' h';
    return 'há ' + Math.floor(s / 86400) + ' d';
  }
  function duration(seconds) {
    if (seconds < 90) return seconds + ' s';
    if (seconds < 5400) return Math.round(seconds / 60) + ' min';
    return (seconds / 3600).toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + ' h';
  }

  /* ---- header actions ---- */
  window.consoleAction = async function (op) {
    const res = await fetch('/sessions/' + enc + '/' + op, { method: 'POST', credentials: 'same-origin' });
    if (op === 'delete' && res.ok) { location.href = '/'; return; }
    await refreshStatus();
    if (provider !== 'cloud' && op === 'connect') await waitForQr();
  };
  async function waitForQr() {
    for (let i = 0; i < 30; i++) {
      await new Promise(r => setTimeout(r, 1000));
      await refreshStatus();
      if ($('pair-qr').querySelector('svg') || $('linked-view').hidden === false) return;
    }
  }
  window.confirmLogout = function () {
    if (confirm('Desvincular "' + sid + '" do WhatsApp?\n\nO aparelho será removido do telefone. A sessão, os webhooks, as configurações e as mensagens serão preservados. Conecte e leia o QR Code novamente para continuar.')) {
      consoleAction('logout');
    }
  };
  window.confirmDelete = function () {
    if (confirm('Excluir "' + sid + '" permanentemente?\n\nIsso remove a sessão, os webhooks, as configurações e o vínculo armazenado. Esta ação não pode ser desfeita.' + (provider === 'cloud' ? '' : '\n\nPara remover apenas o vínculo do telefone e preservar os dados, use Desvincular.'))) {
      consoleAction('delete');
    }
  };

  /* ---- status ---- */
  const STATUS = {
    logged_in: ['connected', 'Conectada'],
    connected: ['connecting', 'Autenticando'],
    connecting: ['connecting', 'Conectando'],
    waiting_for_qr: ['pairing', 'Aguardando leitura do QR Code'],
    waiting_for_pair_code: ['pairing', 'Aguardando código de vínculo'],
    disconnected: ['idle', 'Desconectada'],
  };

  async function refreshStatus() {
    const r = await call('GET', api + '/status');
    if (!r.ok || !r.json) return;
    const s = r.json;
    const d = s.diagnostics || {};
    renderWebhooks(d.webhooks || []);

    if (provider === 'cloud') {
      const st = $('head-status');
      st.className = 'status connected';
      st.textContent = 'Pronta';
      return;
    }

    const [cls, label] = STATUS[s.status] || ['idle', s.status];
    const st = $('head-status');
    st.className = 'status ' + cls;
    st.textContent = s.paused ? 'Pausada' : label;
    setText('head-phone', s.phone_number || '');

    const linked = s.is_logged_in === true && s.status === 'logged_in';
    const busy = s.status === 'connecting' || s.status === 'connected';
    const pairing = s.status === 'waiting_for_qr' || s.status === 'waiting_for_pair_code';
    show('act-connect', s.status === 'disconnected');
    show('act-disconnect', linked || busy || pairing);
    show('act-logout', linked);

    show('linked-view', linked);
    show('pair-panel', !linked);
    show('pair-dormant-note', s.status === 'disconnected');
    setText('connection-note', linked ? 'vinculada e conectada' : pairing ? 'leia o código para vincular' : busy ? 'conectando ao WhatsApp' : 'desconectada');
    if (linked) {
      setText('lv-phone', s.phone_number || '—');
      setText('lv-name', s.push_name || '—');
      setText('lv-last', ago(d.last_data_received_at));
      setText('lv-forwarded', String(d.messages_forwarded == null ? '—' : d.messages_forwarded));
    } else if (s.status === 'disconnected') {
      $('pair-qr').innerHTML = '<div class="hint">Desconectada. Clique em <b>Conectar</b> para obter um QR Code.</div>';
      if (s.pair && s.pair.last_error) {
        const failure = document.createElement('div');
        failure.className = 'hint';
        failure.textContent = 'A conexão foi encerrada. Motivo: ' + s.pair.last_error;
        $('pair-qr').replaceChildren(failure);
      }
    } else if (pairing) {
      await refreshQr();
    } else if (busy) {
      $('pair-qr').innerHTML = '<div class="hint">Conectando ao WhatsApp…</div>';
    }

    const nc = d.new_chats || {};
    setText('nc-3', nc.last_3h == null ? '—' : nc.last_3h);
    setText('nc-6', nc.last_6h == null ? '—' : nc.last_6h);
    setText('nc-12', nc.last_12h == null ? '—' : nc.last_12h);
    setText('nc-24', nc.last_24h == null ? '—' : nc.last_24h);
  }

  async function refreshQr() {
    try {
      const res = await fetch('/qr-svg/' + enc + '?t=' + Date.now(), { credentials: 'same-origin' });
      if (res.status === 204 || !res.ok) return;
      const svg = await res.text();
      if (svg && svg.startsWith('<')) $('pair-qr').innerHTML = svg;
    } catch (_) {}
  }

  /* ---- webhooks ---- */
  function renderWebhooks(hooks) {
    const el = $('webhook-list');
    if (!hooks.length) {
      el.innerHTML = '<div class="empty">Nenhum webhook cadastrado. Os eventos desta sessão ainda não têm um destino.</div>';
      return;
    }
    el.innerHTML = hooks.map(w => {
      let chip;
      let detail = '';
      if (!w.enabled) {
        chip = '<span class="chip">Desativado</span>';
      } else if (w.circuit_open) {
        chip = '<span class="chip bad">Suspenso</span>';
        detail = 'Houve falhas repetidas nas entregas. Nova tentativa em ' + duration(w.retry_in_seconds || 0) + '; as entregas são retomadas automaticamente quando o destino responder.';
      } else if (w.consecutive_failures > 0) {
        chip = '<span class="chip warn">' + w.consecutive_failures + ' falhas seguidas</span>';
      } else {
        chip = '<span class="chip ok">Entregando</span>';
      }
      if (w.last_error) detail += (detail ? ' ' : '') + 'Último erro: ' + w.last_error + '.';
      if (w.skipped_while_suspended) detail += ' ' + w.skipped_while_suspended + ' evento(s) ignorado(s) durante a suspensão.';
      return '<div class="row"><div class="row-main">' +
        '<div class="row-url">' + esc(w.url) + '</div>' +
        '<div class="btn-row">' + chip + (w.receives_messages ? '' : '<span class="chip">sem eventos de mensagem</span>') + '</div>' +
        (detail ? '<div class="hint">' + esc(detail) + '</div>' : '') +
        '</div><div class="btn-row">' +
        (!w.enabled ? '<button class="btn sm" data-wh-enable="' + esc(w.id) + '">Ativar</button>' : '') +
        '<button class="btn sm ghost" data-wh-remove="' + esc(w.id) + '">Remover</button>' +
        '</div></div>';
    }).join('');
    el.querySelectorAll('[data-wh-remove]').forEach(b => b.addEventListener('click', async () => {
      if (!confirm('Remover este webhook?')) return;
      await call('DELETE', api + '/webhooks/' + encodeURIComponent(b.dataset.whRemove));
      refreshStatus();
    }));
    el.querySelectorAll('[data-wh-enable]').forEach(b => b.addEventListener('click', async () => {
      await call('POST', api + '/webhooks/' + encodeURIComponent(b.dataset.whEnable) + '/enable');
      refreshStatus();
    }));
  }

  $('webhook-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const errEl = $('webhook-error');
    errEl.hidden = true;
    const r = await call('POST', api + '/webhooks', { url: $('wh-url').value.trim(), events: [$('wh-events').value] });
    if (!r.ok) { errEl.textContent = errorOf(r); errEl.hidden = false; return; }
    $('wh-url').value = '';
    refreshStatus();
  });

  /* ---- new-chat limit ---- */
  function renderLimit(body) {
    const limit = body.limit;
    $('nc-max').value = limit ? limit.max_new_chats : '';
    $('nc-window').value = limit ? limit.window_hours : 24;
    show('nc-clear', !!limit);
    let state = limit
      ? 'Limite: ' + limit.max_new_chats + ' novas conversas a cada ' + limit.window_hours + ' h.'
      : 'Nenhum limite definido. Os envios não são bloqueados por este controle.';
    if (body.retry_after_seconds) state += ' Limite atingido: próxima nova conversa permitida em ' + duration(body.retry_after_seconds) + '.';
    setText('nc-state', state);
    const incidents = body.incidents || [];
    $('nc-incidents').innerHTML = incidents.length
      ? '<div class="label" style="margin-bottom:6px">Desvinculações registradas pelo WhatsApp</div>' +
        incidents.slice(0, 5).map(i =>
          '<div class="hint">' + esc(new Date(i.occurred_at * 1000).toLocaleString('pt-BR')) + ' · ' + esc(i.reason) +
          ' · novas conversas: ' + i.new_chats.last_3h + ' / ' + i.new_chats.last_6h + ' / ' + i.new_chats.last_12h + ' / ' + i.new_chats.last_24h +
          ' (3 / 6 / 12 / 24 h)</div>').join('')
      : '';
  }
  async function refreshLimit() {
    const r = await call('GET', api + '/settings/new-chat-limit');
    if (r.ok && r.json) renderLimit(r.json);
  }
  if ($('nc-form')) {
    $('nc-form').addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const max = Number($('nc-max').value);
      if (!max) { setText('nc-state', 'Informe o máximo de novas conversas ou clique em Remover limite.'); return; }
      const r = await call('PUT', api + '/settings/new-chat-limit', { max_new_chats: max, window_hours: Number($('nc-window').value) || 24 });
      if (r.ok) renderLimit(r.json); else setText('nc-state', errorOf(r));
    });
    $('nc-clear').addEventListener('click', async () => {
      const r = await call('DELETE', api + '/settings/new-chat-limit');
      if (r.ok) renderLimit(r.json);
    });
  }

  /* ---- cloud URLs ---- */
  setText('cloud-webhook-url', location.origin + api + '/cloud/webhook');
  setText('cloud-flow-url', location.origin + api + '/cloud/flow-endpoint/exchange');
  document.querySelectorAll('[data-copy]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = $(btn.dataset.copy).textContent;
      try { await navigator.clipboard.writeText(text); btn.textContent = 'Copiado'; }
      catch (_) { btn.textContent = 'Selecione e copie'; }
      setTimeout(() => { btn.textContent = 'Copiar'; }, 1500);
    });
  });

  /* ---- pair by code ---- */
  if ($('pair-request')) {
    $('pair-request').addEventListener('click', async () => {
      const errEl = $('pair-error');
      errEl.hidden = true; show('pair-code', false); show('pair-code-hint', false);
      const phone = $('pair-phone').value.trim();
      if (!phone) { errEl.textContent = 'Informe o número de telefone primeiro.'; errEl.hidden = false; return; }
      $('pair-request').disabled = true;
      try {
        const r = await call('POST', api + '/pair', { phone_number: phone, show_push_notification: true });
        if (!r.ok) { errEl.textContent = errorOf(r); errEl.hidden = false; return; }
        const code = ((r.json && r.json.code) || '').trim().toUpperCase();
        if (!code) {
          errEl.textContent = 'Ainda conectando ao WhatsApp. Tente novamente em alguns segundos.';
          errEl.hidden = false;
          return;
        }
        $('pair-code').textContent = code.length === 8 ? code.slice(0, 4) + '-' + code.slice(4) : code;
        show('pair-code', true);
        $('pair-code-hint').innerHTML = 'No telefone: <b>Aparelhos conectados → Conectar com número de telefone</b>. Depois, digite este código.';
        show('pair-code-hint', true);
      } finally {
        $('pair-request').disabled = false;
      }
    });
  }

  /* ---- API explorer ---- */
  const groups = window.__GROUP_META__ || {};
  const onlyOf = (e) => e.only || (groups[e.group] && groups[e.group].only);
  const endpoints = (window.__ENDPOINTS__ || []).map(e => {
    const only = onlyOf(e);
    return Object.assign({}, e, { unavailable: !!only && only !== provider });
  });
  const usable = endpoints.filter(e => !e.unavailable);
  const unusable = endpoints.filter(e => e.unavailable);
  const otherChannel = provider === 'cloud' ? 'uma sessão vinculada pelo WhatsApp Web' : 'uma sessão da Cloud API';

  const sidebarEl = $('pg-sidebar-tree');
  const formEl = $('pg-form');
  const resStatusEl = $('pg-result-status');
  const resBodyEl = $('pg-result-body');
  const expanded = new Set();
  let activeEndpoint = null;
  let filter = '';

  const shortPath = (ep) => ep.path.replace('/api/v1/sessions/{sid}', '') || '/';

  function matches(ep) {
    if (!filter) return true;
    const hay = (ep.label + ' ' + ep.path + ' ' + ep.method + ' ' + ((groups[ep.group] || {}).title || '')).toLowerCase();
    return hay.includes(filter);
  }

  function groupNode(g, items) {
    const meta = groups[g] || { title: g };
    const details = document.createElement('details');
    details.className = 'ex-group';
    details.open = !!filter || expanded.has(g);
    details.addEventListener('toggle', () => { if (details.open) expanded.add(g); else expanded.delete(g); });
    const summary = document.createElement('summary');
    summary.innerHTML = '<span>' + esc(meta.title) + '</span><span class="ex-count">' + items.length + '</span>';
    details.appendChild(summary);
    items.forEach(ep => {
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'ex-item' + (activeEndpoint === ep ? ' active' : '');
      row.title = ep.method + ' ' + shortPath(ep);
      row.innerHTML =
        '<span class="ex-verb v-' + ep.method.toLowerCase() + '">' + (ep.method === 'DELETE' ? 'DEL' : ep.method) + '</span>' +
        '<span class="ex-name">' + esc(ep.label) + '</span>';
      row.addEventListener('click', () => {
        activeEndpoint = ep;
        history.replaceState(null, '', '#' + ep.group + '/' + ep.key);
        renderSidebar();
        renderForm();
      });
      details.appendChild(row);
    });
    return details;
  }

  function renderSidebar() {
    sidebarEl.innerHTML = '';
    const draw = (list) => {
      Array.from(new Set(list.map(e => e.group))).forEach(g => {
        const items = list.filter(e => e.group === g && matches(e));
        if (items.length) sidebarEl.appendChild(groupNode(g, items));
      });
    };
    draw(usable);
    if (unusable.some(matches)) {
      const section = document.createElement('div');
      section.className = 'ex-unavailable';
      const head = document.createElement('div');
      head.className = 'ex-section';
      head.textContent = 'Requer ' + otherChannel;
      section.appendChild(head);
      const keep = sidebarEl;
      Array.from(new Set(unusable.map(e => e.group))).forEach(g => {
        const items = unusable.filter(e => e.group === g && matches(e));
        if (items.length) section.appendChild(groupNode(g, items));
      });
      keep.appendChild(section);
    }
    if (!sidebarEl.children.length) sidebarEl.innerHTML = '<p class="muted" style="padding:12px">Nenhuma operação encontrada.</p>';
  }

  $('pg-filter').addEventListener('input', (ev) => { filter = ev.target.value.trim().toLowerCase(); renderSidebar(); });

  // Translate display labels only; API enum values remain unchanged.
  const OPTION_LABELS = {
  "audio": "Áudio",
  "video": "Vídeo",
  "voice": "Voz",
  "available": "Disponível",
  "unavailable": "Indisponível",
  "composing": "Digitando",
  "recording": "Gravando",
  "paused": "Pausada",
  "inactive": "Inativas",
  "logged_out": "Desvinculadas",
  "disconnected": "Desconectadas",
  "all": "Todas",
  "incremental": "Incremental",
  "snapshot": "Completo",
  "navigate": "Navegar",
  "data_exchange": "Troca de dados",
  "off": "Desativada",
  "on": "Ativada",
  "processing": "Em processamento",
  "partially_shipped": "Enviado parcialmente",
  "shipped": "Enviado",
  "completed": "Concluído",
  "canceled": "Cancelado",
  "published": "Publicado",
  "draft": "Rascunho",
  "admin_add": "Administradores",
  "all_member_add": "Todos os membros",
  "admin_link": "Administradores",
  "all_member_link": "Todos os membros",
  "SMS": "SMS",
  "VOICE": "Ligação",
  "UTILITY": "Utilidade",
  "MARKETING": "Marketing",
  "AUTHENTICATION": "Autenticação",
  "DAY": "Dia",
  "DAILY": "Diária",
  "HOUR": "Hora",
  "HALF_HOUR": "Meia hora",
  "MONTH": "Mês",
  "MONTHLY": "Mensal",
  "LIFETIME": "Todo o período",
  "IN": "Índia",
  "SG": "Singapura",
  "ENDPOINT_REQUEST_COUNT": "Quantidade de requisições",
  "ENDPOINT_REQUEST_ERROR": "Erros nas requisições",
  "ENDPOINT_REQUEST_ERROR_RATE": "Taxa de erros",
  "ENDPOINT_REQUEST_LATENCY_SECONDS_CEIL": "Latência das requisições (segundos)",
  "ENDPOINT_AVAILABILITY": "Disponibilidade do endpoint"
};

  function renderForm() {
    const ep = activeEndpoint;
    if (!ep) return;
    const verb = $('pg-method');
    verb.textContent = ep.method;
    verb.className = 'ex-method v-' + ep.method.toLowerCase();
    setText('pg-url', ep.path.replace('{sid}', sid));
    setText('pg-current-label', ep.label);
    show('pg-send', !ep.unavailable);
    show('pg-curl', !ep.unavailable);
    formEl.innerHTML = '';
    resStatusEl.textContent = '';
    resBodyEl.textContent = '';

    if (ep.unavailable) {
      formEl.innerHTML = '<p>Esta operação requer ' + otherChannel + '. Ela não está disponível nesta sessão.</p>';
      return;
    }
    if (!ep.fields.length) {
      formEl.innerHTML = '<p class="muted">Sem parâmetros.</p>';
      return;
    }
    ep.fields.forEach(f => {
      const row = document.createElement('label');
      row.className = 'ex-field';
      const name = document.createElement('span');
      name.className = 'ex-field-name';
      name.innerHTML = '<code>' + esc(f.name) + '</code>' + (f.required ? '<em>obrigatório</em>' : '') +
        (f.label && f.label !== f.name ? '<small>' + esc(f.label) + '</small>' : '');
      row.appendChild(name);
      let input;
      if (f.type === 'textarea' || f.type === 'json') {
        input = document.createElement('textarea');
        input.rows = f.type === 'json' ? 4 : 2;
        input.spellcheck = false;
      } else if (f.type === 'select') {
        input = document.createElement('select');
        (f.options || []).forEach(opt => {
          const o = document.createElement('option');
          o.value = opt; o.textContent = OPTION_LABELS[opt] || opt;
          input.appendChild(o);
        });
      } else {
        input = document.createElement('input');
        input.type = f.type === 'file' ? 'file' : f.type === 'checkbox' ? 'checkbox' : f.type === 'number' ? 'number' : 'text';
      }
      input.name = f.name;
      input.dataset.type = f.type;
      if (f.placeholder) input.placeholder = f.placeholder;
      if (f.default !== undefined) {
        if (f.type === 'checkbox') input.checked = !!f.default;
        else input.value = String(f.default);
      }
      row.appendChild(input);
      formEl.appendChild(row);
    });
  }

  function collectValues() {
    const values = {};
    formEl.querySelectorAll('input, textarea, select').forEach(el => {
      const t = el.dataset.type;
      if (t === 'checkbox') values[el.name] = el.checked;
      else if (t === 'file') values[el.name] = el.files && el.files[0] ? el.files[0] : null;
      else if (t === 'number') values[el.name] = el.value === '' ? null : Number(el.value);
      else if (t === 'json') {
        if (el.value.trim()) {
          try { values[el.name] = JSON.parse(el.value); }
          catch (e) { throw new Error('"' + el.name + '" não contém JSON válido: ' + e.message); }
        }
      }
      else if (t === 'textarea') values[el.name] = el.value;
      else values[el.name] = (el.value || '').trim();
    });
    return values;
  }

  const filled = (v) => v !== undefined && v !== null && v !== '';

  function appendQuery(path, params) {
    const qs = new URLSearchParams();
    Object.keys(params).forEach(k => {
      const v = params[k];
      qs.append(k, typeof v === 'object' ? JSON.stringify(v) : String(v));
    });
    const query = qs.toString();
    return query ? path + (path.includes('?') ? '&' : '?') + query : path;
  }

  function fail(message) {
    resStatusEl.textContent = 'não enviado';
    resStatusEl.className = 'ex-status bad';
    resBodyEl.textContent = message;
  }

  /* Turns the form into what goes on the wire. Throws on invalid input. */
  function buildRequest() {
    const ep = activeEndpoint;
    const values = collectValues();
    const missing = ep.fields.filter(f => f.required && !filled(values[f.name])).map(f => f.name);
    if (missing.length) throw new Error('Campos obrigatórios: ' + missing.join(', '));

    let path = ep.path.replace('{sid}', enc);
    const body = {};
    const query = {};
    ep.fields.forEach(f => {
      if (f.in_path) path = path.replace('{' + f.name + '}', encodeURIComponent(values[f.name] || ''));
      else if (!filled(values[f.name])) return;
      else if (f.in_query) query[f.name] = values[f.name];
      else body[f.name] = values[f.name];
    });
    path = appendQuery(path, query);

    const req = { method: ep.method, path, json: undefined, form: undefined };
    if (ep.method === 'GET') req.path = appendQuery(path, body);
    else if (ep.fields.some(f => f.type === 'file')) {
      req.form = new FormData();
      Object.keys(body).forEach(k => req.form.append(k, body[k]));
    }
    else if (ep.raw_body) req.json = body[ep.raw_body];
    else if (Object.keys(body).length) req.json = body;
    return req;
  }

  async function submit() {
    let req;
    try { req = buildRequest(); } catch (e) { fail(e.message); return; }
    const opts = { method: req.method, credentials: 'same-origin', headers: {} };
    if (req.form) opts.body = req.form;
    else if (req.json !== undefined) {
      opts.headers['content-type'] = 'application/json';
      opts.body = JSON.stringify(req.json);
    }
    resStatusEl.textContent = 'enviando';
    resStatusEl.className = 'ex-status';
    resBodyEl.textContent = '';
    const started = performance.now();
    try {
      const res = await fetch(req.path, opts);
      const text = await res.text();
      const ms = Math.round(performance.now() - started);
      let parsed = null;
      let pretty = text;
      try { parsed = JSON.parse(text); pretty = JSON.stringify(parsed, null, 2); } catch (e) { /* not JSON */ }
      resStatusEl.textContent = res.status + ' ' + res.statusText + ' · ' + ms + ' ms';
      resStatusEl.className = 'ex-status ' + (res.ok ? 'ok' : 'bad');
      resBodyEl.textContent = pretty;
      renderRecordingPlayer(parsed);
      refreshStatus();
    } catch (e) {
      fail(String(e));
    }
  }

  $('pg-send').addEventListener('click', submit);
  $('pg-curl').addEventListener('click', async () => {
    let req;
    try { req = buildRequest(); } catch (e) { fail(e.message); return; }
    const quote = (v) => "'" + String(v).replace(/'/g, "'\\''") + "'";
    let cmd = 'curl -X ' + req.method + ' ' + quote(location.origin + req.path) + ' \\\n  -H ' + quote('Authorization: Bearer $WAXUM_TOKEN');
    if (req.form) cmd += ' \\\n  -F ' + quote('file=@/path/to/file');
    else if (req.json !== undefined) cmd += ' \\\n  -H ' + quote('Content-Type: application/json') + ' \\\n  -d ' + quote(JSON.stringify(req.json));
    try { await navigator.clipboard.writeText(cmd); $('pg-curl').textContent = 'Copiado'; }
    catch (_) { resBodyEl.textContent = cmd; }
    setTimeout(() => { $('pg-curl').textContent = 'Copiar curl'; }, 1500);
  });

  function renderRecordingPlayer(body) {
    let host = $('pg-recording');
    if (host) host.remove();
    if (!body || typeof body.recording_url !== 'string' || !body.recording_url) return;
    host = document.createElement('div');
    host.id = 'pg-recording';
    host.className = 'ex-recording';
    host.innerHTML =
      '<div>Áudio do interlocutor, disponível após a chamada: <code>' + esc(body.recording_url) + '</code> ' +
      '<button type="button" class="btn sm" id="pg-recording-reload">Recarregar</button></div>' +
      '<audio id="pg-recording-audio" controls preload="none" src="' + esc(body.recording_url) + '"></audio>';
    resBodyEl.parentElement.appendChild(host);
    $('pg-recording-reload').addEventListener('click', () => {
      const audio = $('pg-recording-audio');
      audio.src = body.recording_url + '?t=' + Date.now();
      audio.load();
      audio.play().catch(() => {});
    });
  }

  const linked = endpoints.find(e => '#' + e.group + '/' + e.key === location.hash);
  if (linked) { activeEndpoint = linked; expanded.add(linked.group); }
  else if (usable.length) expanded.add(usable[0].group);
  renderSidebar();
  renderForm();

  refreshStatus();
  if (provider !== 'cloud') {
    refreshQr();
    refreshLimit();
  }
  setInterval(refreshStatus, 3000);
})();
</script>
